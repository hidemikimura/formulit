{
  "name": "formulit-monorepo",
  "private": true,
  "description": "formulit（HTML 用）と formulit-markdown（Markdown 用）の WYSIWYG エディタ",
  "license": "MIT",
  "author": "Hidemi Kimura",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npx --yes http-server -c-1 -o /demo/ .",
    "test": "node test/run.mjs",
    "test:markdown": "node test/markdown.mjs",
    "test:all": "for b in chromium firefox webkit; do BROWSER=$b node test/run.mjs && BROWSER=$b node test/markdown.mjs || exit 1; done",
    "perf": "node test/perf.mjs large",
    "docs:build": "node scripts/build-docs.mjs",
    "docs": "node scripts/build-docs.mjs && npx --yes http-server -c-1 -o / docs",
    "test:docs": "node test/docs.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "lit": "^3.3.3",
    "playwright": "^1.63.0"
  }
}
