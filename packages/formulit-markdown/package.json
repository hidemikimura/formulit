{
  "name": "@hidemikimura/formulit-markdown",
  "version": "0.1.0",
  "description": "見たまま編集して Markdown（GFM）で保存する、Lit 製の WYSIWYG Markdown エディタ（<formulit-markdown>）",
  "keywords": ["markdown", "gfm", "wysiwyg", "editor", "lit", "web-components", "custom-elements", "typora", "formulit"],
  "homepage": "https://hidemikimura.github.io/formulit/markdown.html",
  "bugs": { "url": "https://github.com/hidemikimura/formulit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/hidemikimura/formulit.git", "directory": "packages/formulit-markdown" },
  "license": "MIT",
  "author": "Hidemi Kimura",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": { ".": "./src/index.js", "./package.json": "./package.json" },
  "sideEffects": ["./src/index.js"],
  "files": ["src", "CHANGELOG.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "release:check": "node ../../scripts/release-check.mjs",
    "prepublishOnly": "node ../../scripts/release-check.mjs",
    "release:notes": "node ../../scripts/release-notes.mjs"
  },
  "dependencies": { "markdown-it": "^15.0.2" },
  "peerDependencies": { "@hidemikimura/formulit": "^0.3.0", "lit": "^3.0.0" }
}
